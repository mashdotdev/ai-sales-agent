# Gemini — powers both the voice agent (Live API) and the text agents
# (Agents SDK via Gemini's OpenAI-compatible endpoint). One key, both jobs.
GEMINI_API_KEY=
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-preview

# Postgres — Neon. Schema is owned by Prisma in web/, FastAPI only reads/
# writes. Use the DIRECT (non-pooled) connection string here — i.e. the
# endpoint host WITHOUT "-pooler" in it — not the one web/.env.local uses.
# asyncpg's prepared-statement cache breaks against PgBouncer-style pooled
# connections (see the comment on connect_args in db/engine.py); Prisma
# doesn't have this problem, so web/ uses the pooled string instead.
# scheme must stay postgresql+asyncpg://, and use ssl=require (not
# sslmode=require — that's the libpq/psycopg spelling, asyncpg wants "ssl").
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?ssl=require

# Qdrant — not wired up yet (lands in Phase 2, on Qdrant Cloud's free tier;
# there's no local Docker fallback since docker-compose.yml was dropped in
# favor of Neon/Qdrant Cloud). Leave blank until then.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=company_knowledge

# Shared secret for the Next.js -> FastAPI boundary. Generate with:
#   openssl rand -hex 32
# Must match INTERNAL_API_SECRET in web/.env.local exactly.
INTERNAL_API_SECRET=

# HubSpot private app token (Phase 5). Needs contacts, companies, deals,
# tasks, and engagements scopes.
HUBSPOT_PRIVATE_APP_TOKEN=

# Slack incoming webhook (Phase 5).
SLACK_WEBHOOK_URL=

# Voice call guardrails (Phase 3) — protect the free Gemini quota, not billing.
CALL_MAX_DURATION_SECONDS=600
CALL_RATE_LIMIT_PER_IP_PER_HOUR=10

# Outbound email safety (Phase 6). Keep true until you deliberately want
# Gmail sends to leave this machine.
DRY_RUN=true
