# FastAPI backend
FASTAPI_URL=http://localhost:8010

# Shared secret for the Next.js -> FastAPI boundary. Generate with:
#   openssl rand -hex 32
# Must match INTERNAL_API_SECRET in backend/.env exactly.
INTERNAL_API_SECRET=

# Postgres — Neon. Prisma owns the schema (see prisma/schema.prisma). Use the
# POOLED connection string here (has "-pooler" in the endpoint host) — Prisma
# 5.10+ supports pooled connections for both migrations and the client, so
# there's no need for a separate direct/unpooled DIRECT_URL on this side.
# (backend/.env.example uses the direct string instead — asyncpg doesn't
# tolerate PgBouncer-style pooling the way Prisma does.)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Better Auth (Phase 1)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (Phase 1) — needs Gmail + Calendar scopes for the Workspace
# connect flow, on top of whatever scopes plain login uses.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend — transactional email for Better Auth (Phase 1)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Inngest (Phase 6+). Dev server needs neither key.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
